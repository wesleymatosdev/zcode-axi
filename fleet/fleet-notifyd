#!/usr/bin/env bash
# fleet-notifyd — spawn-side notify shim (the worker never knows it exists).
#
# Usage: fleet-notifyd <task-id>   (started by fleet-spawn, not by hand)
#
# Tails fleet/state/<task-id>.status and publishes every new worker status
# line to the bus via `pushevent`, so the coordinator's fleet-wait wakes on
# push within milliseconds of the write. The tail/timer-shim shape was
# chosen precisely so NO worker brief or behavior changes — the shim lives
# in the spawn flow, workers keep appending lines exactly as before.
#
# Law: the status file is the durable record; this shim is only the
# notification layer. Bus down ⇒ the line is already on disk; the shim
# attempts start-on-demand (fleet-bus ensure) once, then keeps tailing and
# warning — a missed push costs latency, never correctness, because the
# watcher's poll fallback reconciles from the file.
#
# Publishes the status grammar's bus states: working|blocked|
# needs-decision|ready-for-review|done|failed. Non-bus lines
# (spawned/dispatched/failed-reason/handoff/steered) are skipped — they are
# intermediate bookkeeping; spawned/dispatched are published by fleet-spawn
# itself at dispatch time.
#
# Exits when: the file reaches done:/failed: (nothing left to announce),
# the status file vanishes (archived), or the task's window is gone
# (worker swept). Every decision lands in logs/<task-id>.notify.log.
set -euo pipefail

FLEET_ROOT="$(cd "$(dirname "$0")" && pwd)"
addr="${FLEET_BUS_ADDR:-tcp:127.0.0.1:47777}"

[ $# -eq 1 ] || { echo "usage: $0 <task-id>" >&2; exit 1; }
task_id="$1"
status="$FLEET_ROOT/state/$task_id.status"
window="fleet-$task_id"

note() { printf '%s fleet-notifyd: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

resolve_pushevent() {
  local cand
  for cand in "${FLEET_PUSHEVENT_BIN:-}" "$HOME/.local/bin/pushevent" "$HOME/projects/personal/fleet-bus/bin/pushevent"; do
    if [ -n "$cand" ] && [ -x "$cand" ]; then printf '%s' "$cand"; return 0; fi
  done
  return 1
}

pushevent_bin="$(resolve_pushevent)" || {
  note "WARN pushevent binary not found (looked in \$FLEET_PUSHEVENT_BIN, ~/.local/bin, ~/projects/personal/fleet-bus/bin) — exiting; poll fallback covers the task"
  exit 1
}

[ -f "$status" ] || { note "no status file: $status — exiting"; exit 1; }

# Match on the line with an optional leading ISO timestamp stripped —
# workers timestamp their entries and the keyword may not be first.
strip_ts() { printf '%s' "$1" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})? +//'; }

publish() {
  "$pushevent_bin" -bus "$addr" -state "$1" -summary "$2" "$task_id" >/dev/null 2>&1
}

note "tail start task=$task_id addr=$addr"
last=0
ensure_tried=0
warned=0
while :; do
  if [ ! -f "$status" ]; then
    note "status file gone (archived) — exiting"
    exit 0
  fi
  cur="$(wc -l <"$status" | tr -d ' ')"
  if [ "$cur" -gt "$last" ]; then
    while IFS= read -r line; do
      l="$(strip_ts "$line")"
      kw="${l%%:*}"
      summary="${l#*: }"
      case "$kw" in
        working | blocked | needs-decision | ready-for-review | done | failed) ;;
        *) note "skip non-bus line: $kw"; continue ;;
      esac
      if ! publish "$kw" "$summary"; then
        if [ "$ensure_tried" -eq 0 ]; then
          ensure_tried=1
          note "push failed — attempting bus start-on-demand"
          "$FLEET_ROOT/fleet-bus" ensure >>"$FLEET_ROOT/logs/busd.log" 2>&1 || true
          if publish "$kw" "$summary"; then
            note "published after ensure: $kw"
          else
            note "WARN bus unreachable — line only on disk, poll fallback will reconcile: $l"
          fi
        else
          if [ "$warned" -eq 0 ]; then
            note "WARN bus down — continuing tail; file is the record"
            warned=1
          fi
        fi
      fi
      case "$kw" in
        done | failed)
          note "terminal line published ($kw) — exiting"
          exit 0
          ;;
      esac
    done < <(sed -n "$((last + 1)),${cur}p" "$status")
    last="$cur"
  fi
  # Window gone ⇒ the worker was archived/swept; nothing left to announce.
  tmux list-windows -t zswarm -F '#{window_name}' 2>/dev/null | grep -qx "$window" || {
    note "window $window gone — exiting"
    exit 0
  }
  sleep 1
done
