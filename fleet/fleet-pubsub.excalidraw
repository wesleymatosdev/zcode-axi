{
  "type": "excalidraw",
  "version": 2,
  "source": "hermes-agent",
  "elements": [
    { "type": "text", "id": "title", "x": 400, "y": 20, "text": "fleet pub-sub: how the worker's message reaches your Telegram", "fontSize": 24, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "fleet pub-sub: how the worker's message reaches your Telegram", "autoResize": true },

    { "type": "rectangle", "id": "worker", "x": 40, "y": 120, "width": 240, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_worker", "type": "text" }] },
    { "type": "text", "id": "t_worker", "x": 50, "y": 130, "width": 220, "height": 100, "text": "ZCode worker\ntmux window fleet-<task>\n(free Flash lane)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "worker", "originalText": "ZCode worker\ntmux window fleet-<task>\n(free Flash lane)", "autoResize": true },

    { "type": "text", "id": "n1", "x": 320, "y": 150, "text": "1. worker hits a\nmilestone: appends\nstatus line to\nstate/<task>.status", "fontSize": 16, "fontFamily": 1, "strokeColor": "#757575", "originalText": "1. worker hits a\nmilestone: appends\nstatus line to\nstate/<task>.status", "autoResize": true },

    { "type": "rectangle", "id": "statusfile", "x": 520, "y": 110, "width": 230, "height": 140, "roundness": { "type": 3 }, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [{ "id": "t_statusfile", "type": "text" }] },
    { "type": "text", "id": "t_statusfile", "x": 530, "y": 120, "width": 210, "height": 120, "text": "state/<task>.status\nappend-only file\n(the durable record)\nON DISK", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "statusfile", "originalText": "state/<task>.status\nappend-only file\n(the durable record)\nON DISK", "autoResize": true },

    { "type": "text", "id": "n2", "x": 790, "y": 140, "text": "2. same milestone fires\nzc-event.sh  (30 lines of\nbash, zero AI): formats\none line, calls hermes send", "fontSize": 16, "fontFamily": 1, "strokeColor": "#757575", "originalText": "2. same milestone fires\nzc-event.sh  (30 lines of\nbash, zero AI): formats\none line, calls hermes send", "autoResize": true },

    { "type": "rectangle", "id": "event", "x": 40, "y": 330, "width": 260, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_event", "type": "text" }] },
    { "type": "text", "id": "t_event", "x": 50, "y": 340, "width": 240, "height": 100, "text": "zc-event.sh <task> ready-for-review\n\"one-line summary\"\n= printf + hermes send. That's it.", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "event", "originalText": "zc-event.sh <task> ready-for-review\n\"one-line summary\"\n= printf + hermes send. That's it.", "autoResize": true },

    { "type": "text", "id": "n3", "x": 350, "y": 360, "text": "3. hermes send -t telegram\nreuses gateway creds already\non this machine. Plain HTTPS\nto Bot API. No LLM, no agent.", "fontSize": 16, "fontFamily": 1, "strokeColor": "#757575", "originalText": "3. hermes send -t telegram\nreuses gateway creds already\non this machine. Plain HTTPS\nto Bot API. No LLM, no agent.", "autoResize": true },

    { "type": "rectangle", "id": "tgcloud", "x": 640, "y": 330, "width": 240, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_tgcloud", "type": "text" }] },
    { "type": "text", "id": "t_tgcloud", "x": 650, "y": 340, "width": 220, "height": 100, "text": "Telegram cloud\n(your chat,\nchat_id 8197560052)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "tgcloud", "originalText": "Telegram cloud\n(your chat,\nchat_id 8197560052)", "autoResize": true },

    { "type": "arrow", "id": "a1", "x": 285, "y": 180, "width": 230, "height": 0, "points": [[0, 0], [230, 0]], "endArrowhead": "arrow", "startBinding": { "elementId": "worker", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "statusfile", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "a2", "x": 170, "y": 245, "width": 0, "height": 80, "points": [[0, 0], [0, 80]], "endArrowhead": "arrow", "startBinding": { "elementId": "worker", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "event", "fixedPoint": [0.5, 0] } },
    { "type": "arrow", "id": "a3", "x": 305, "y": 390, "width": 330, "height": 0, "points": [[0, 0], [330, 0]], "endArrowhead": "arrow", "startBinding": { "elementId": "event", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "tgcloud", "fixedPoint": [0, 0.5] } },

    { "type": "text", "id": "sub_title", "x": 60, "y": 530, "text": "SUBSCRIBERS - who sees the event", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "SUBSCRIBERS - who sees the event", "autoResize": true },

    { "type": "rectangle", "id": "livesess", "x": 40, "y": 580, "width": 280, "height": 150, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_livesess", "type": "text" }] },
    { "type": "text", "id": "t_livesess", "x": 50, "y": 590, "width": 260, "height": 130, "text": "LIVE Telegram agent\n(the session you're talking to)\nsees the message as chat context\n= becomes coordinator on reply", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "livesess", "originalText": "LIVE Telegram agent\n(the session you're talking to)\nsees the message as chat context\n= becomes coordinator on reply", "autoResize": true },

    { "type": "rectangle", "id": "cron", "x": 380, "y": 580, "width": 280, "height": 150, "roundness": { "type": 3 }, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{ "id": "t_cron", "type": "text" }] },
    { "type": "text", "id": "t_cron", "x": 390, "y": 590, "width": 260, "height": 130, "text": "digest cron 04dc4248e999\n(every 5 min, durable subscriber)\nverifies + closes if you're AFK", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "cron", "originalText": "digest cron 04dc4248e999\n(every 5 min, durable subscriber)\nverifies + closes if you're AFK", "autoResize": true },

    { "type": "rectangle", "id": "anysess", "x": 720, "y": 580, "width": 280, "height": 150, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_anysess", "type": "text" }] },
    { "type": "text", "id": "t_anysess", "x": 730, "y": 590, "width": 260, "height": 130, "text": "ANY Hermes session\nsessions are interchangeable:\nall state is on disk\n(zc-status / zc-digest)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "anysess", "originalText": "ANY Hermes session\nsessions are interchangeable:\nall state is on disk\n(zc-status / zc-digest)", "autoResize": true },

    { "type": "arrow", "id": "a4", "x": 760, "y": 455, "width": 0, "height": 120, "points": [[0, 0], [0, 120]], "endArrowhead": "arrow", "strokeStyle": "dashed" },
    { "type": "text", "id": "t_a4", "x": 660, "y": 500, "width": 200, "height": 20, "text": "delivered to every subscriber", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "containerId": null, "originalText": "delivered to every subscriber", "autoResize": true },

    { "type": "text", "id": "rev_title", "x": 60, "y": 790, "text": "REVERSE DIRECTION - your reply is steering", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "REVERSE DIRECTION - your reply is steering", "autoResize": true },

    { "type": "rectangle", "id": "reply", "x": 40, "y": 840, "width": 280, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_reply", "type": "text" }] },
    { "type": "text", "id": "t_reply", "x": 50, "y": 850, "width": 260, "height": 100, "text": "you reply on Telegram:\n\"take option B\"\n(live agent context)", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "reply", "originalText": "you reply on Telegram:\n\"take option B\"\n(live agent context)", "autoResize": true },

    { "type": "rectangle", "id": "steer", "x": 480, "y": 840, "width": 280, "height": 120, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_steer", "type": "text" }] },
    { "type": "text", "id": "t_steer", "x": 490, "y": 850, "width": 260, "height": 100, "text": "live session routes it:\nzc-steer.sh <task> \"take option B\"\ntmux send-keys into worker window", "fontSize": 16, "fontFamily": 1, "textAlign": "center", "verticalAlign": "middle", "containerId": "steer", "originalText": "live session routes it:\nzc-steer.sh <task> \"take option B\"\ntmux send-keys into worker window", "autoResize": true },

    { "type": "arrow", "id": "a5", "x": 325, "y": 900, "width": 150, "height": 0, "points": [[0, 0], [150, 0]], "endArrowhead": "arrow", "startBinding": { "elementId": "reply", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "steer", "fixedPoint": [0, 0.5] } },
    { "type": "arrow", "id": "a6", "x": 620, "y": 835, "width": 0, "height": -560, "points": [[0, 0], [0, -560]], "endArrowhead": "arrow", "strokeStyle": "dashed", "strokeColor": "#757575" },
    { "type": "text", "id": "t_a6", "x": 640, "y": 600, "width": 120, "height": 20, "text": "worker is in tmux,\nnot in any session", "fontSize": 14, "fontFamily": 1, "strokeColor": "#757575", "containerId": null, "originalText": "worker is in tmux,\nnot in any session", "autoResize": true }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
