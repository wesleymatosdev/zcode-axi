#!/usr/bin/env bash
# fleet-complete.sh — COORDINATOR-ONLY terminal status write.
#
# Usage: fleet-complete.sh <task-id> <done|failed> <one-line-summary>
#
# Appends the terminal status line to fleet/state/<task-id>.status after
# the coordinator has verified artifacts (commits, tests, reports). A
# worker NEVER writes its own done — self-report does not close a task.
#
# Clean-exit enforcement (2026-09-09): if the task's window is still open
# after closing, prints a reminder to sweep it — the pubsec-audit gap was
# a closed task whose window sat on an unanswered dialog for hours because
# nothing prompted the coordinator to archive it.
set -euo pipefail

FLEET_ROOT="$(cd "$(dirname "$0")" && pwd)"

[ $# -eq 3 ] || { echo "usage: $0 <task-id> <done|failed> <one-line-summary>" >&2; exit 1; }
task_id="$1"
verdict="$2"
summary="$3"

case "$verdict" in
  done | failed) ;;
  *) echo "fleet-complete: verdict must be 'done' or 'failed', got: $verdict" >&2; exit 1 ;;
esac

status="$FLEET_ROOT/state/$task_id.status"
[ -f "$status" ] || { echo "fleet-complete: no such task: $task_id" >&2; exit 1; }

# Status lines are one line by definition.
summary="${summary//$'\n'/ }"
printf '%s: %s\n' "$verdict" "$summary" >>"$status"
echo "$task_id -> $verdict"

window="fleet-$task_id"
if tmux list-windows -t zswarm -F '#{window_name}' 2>/dev/null | grep -qx "$window"; then
  echo "reminder: zswarm:$window is still open — run 'fleet-status --archive' (or fleet-archive) to sweep it; don't leave a closed task's window sitting on an unanswered dialog" >&2
fi
